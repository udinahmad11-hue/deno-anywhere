// proxy.ts - ULTRA FAST PROXY (DEN0)
import { serve } from "https://deno.land/std@0.224.0/http/server.ts";

serve(async (req: Request) => {
  // === CORS ===
  const corsHeaders = {
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "*",
  };

  // ⚡ FAST OPTIONS HANDLING
  if (req.method === "OPTIONS") {
    return new Response(null, { headers: corsHeaders });
  }

  const url = new URL(req.url);
  let targetUrl = url.searchParams.get("url");

  // ⚡ FAST VALIDATION
  if (!targetUrl) {
    return new Response(
      JSON.stringify({
        error: "URL parameter required",
        usage: "/?url=https://example.com",
        example: "/?url=https://api.github.com/users/octocat",
      }),
      {
        status: 400,
        headers: {
          ...corsHeaders,
          "Content-Type": "application/json",
        },
      },
    );
  }

  // ⚡ FAST URL NORMALIZATION
  if (!targetUrl.startsWith("http://") && !targetUrl.startsWith("https://")) {
    targetUrl = "https://" + targetUrl;
  }

  // ⚡ FORWARD ESSENTIAL HEADERS ONLY
  const forwardHeaders = new Headers();
  const skipHeaders = ["host", "connection", "accept-encoding"];

  for (const [key, value] of req.headers.entries()) {
    if (!skipHeaders.includes(key.toLowerCase())) {
      forwardHeaders.set(key, value);
    }
  }

  // Force UA (same as PHP)
  forwardHeaders.set(
    "User-Agent",
    "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
  );

  try {
    // ⚡ HANDLE BODY (POST / PUT / PATCH)
    let body: Uint8Array | null = null;
    if (req.method !== "GET" && req.method !== "HEAD") {
      body = new Uint8Array(await req.arrayBuffer());
    }

    // ⚡ FETCH TARGET
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 15_000);

    const resp = await fetch(targetUrl, {
      method: req.method,
      headers: forwardHeaders,
      body,
      redirect: "follow",
      signal: controller.signal,
    });

    clearTimeout(timeout);

    // ⚡ FORWARD RESPONSE HEADERS
    const resHeaders = new Headers(corsHeaders);
    const contentType = resp.headers.get("content-type");
    if (contentType) {
      resHeaders.set("Content-Type", contentType);
    }

    return new Response(resp.body, {
      status: resp.status,
      headers: resHeaders,
    });
  } catch (err) {
    return new Response(
      JSON.stringify({
        error: "Proxy fetch failed",
        message: String(err),
        url: targetUrl,
      }),
      {
        status: 500,
        headers: {
          ...corsHeaders,
          "Content-Type": "application/json",
        },
      },
    );
  }
});
